# Publish only the selected FaceSwap project and repository metadata.
# Other workspace projects and any future root resources stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ACTIVE_PROJECT.json
!/faceswap_pipeline/

# Python environments, compiled files, and caches
.venv*/
venv/
env/
*-venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# Downloaded model weights and inference artifacts.
# Keep model source code, JSON manifests, and download scripts versioned.
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.tflite
*.pb
*.task
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.bin
*.engine
*.plan
.assets/

# Local inputs, generated renders, run logs, and resource snapshots
/backups/
/input_faces/
/input_video/
/target_videos/
inputs/
prepared/
outputs/
output/
test_results/
test_media/
logs/
*.log

# Large media and downloadable archives
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM][kK][vV]
*.[aA][vV][iI]
*.[wW][eE][bB][mM]
*.[mM]4[vV]
*.[wW][aA][vV]
*.[mM][pP]3
*.[fF][lL][aA][cC]
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.tgz
*.gz
*.xz
*.part
*.tmp
*.aria2

# Local secrets and runtime credentials
.env
.env.*
!.env.example
!.env.sample
!.env.template
.ssh/
*.pem
*.key
id_rsa*
id_ed25519*
vnc_password.txt
.vncpass

# Editor and operating-system artifacts
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
node_modules/
